{
  "name": "faircart",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/extension",
    "apps/shop",
    "apps/web",
    "apps/server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @faircart/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "icons": "python scripts/make-icons.py apps/extension/public/icon",
    "dev": "npm run dev -w @faircart/extension",
    "build": "npm run build -w @faircart/extension",
    "zip": "npm run zip -w @faircart/extension"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
