# FairCart Agent Guard - local settings. Never commit this file (.env is gitignored).

# --- PayPal (sandbox) ---------------------------------------------------------
# mock = no PayPal calls (default, works offline). sandbox = real PayPal sandbox.
PAYPAL_MODE=mock
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in after deploy: app > Webhooks > add https://<render-url>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- AI planner -----------------------------------------------------------------
# gemini = live AI planner. Without a key, the labelled backup planner (no AI) runs every step.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional: which Gemini model plans each page.
LLM_MODEL=gemini-3.5-flash-lite

# --- Server ---------------------------------------------------------------------
# Signs payment authorizations. Any long random string; generated for you below.
AUTHZ_HMAC_SECRET=change-me-to-a-long-random-string
PORT=8787
